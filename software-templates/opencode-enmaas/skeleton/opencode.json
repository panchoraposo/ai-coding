{
  "$schema": "https://opencode.ai/config.json",
  "model": "maas/${{values.maas_model}}",
  "providers": {
    "maas": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "${{values.maas_base_url}}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "${{values.maas_model}}": {
          "name": "${{values.maas_model}}"
        }
      }
    }
  }
}

# Non-secret MaaS settings baked by the software template.
# The API key is NOT stored here. Dev Spaces reads it from Vault
# secret/apps/${{values.component_id}}/config (key MAAS_API_KEY).
MAAS_BASE_URL=${{values.maas_base_url}}
MAAS_MODEL=${{values.maas_model}}
VAULT_ADDR=http://vault.vault.svc:8200
VAULT_SECRET_PATH=apps/${{values.component_id}}/config

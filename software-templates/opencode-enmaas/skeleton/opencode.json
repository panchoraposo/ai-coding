{
  "$schema": "https://opencode.ai/config.json",
  "model": "maas/${{values.maas_model}}",
  "provider": {
    "maas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MaaS",
      "options": {
        "baseURL": "${{values.maas_base_url}}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "${{values.maas_model}}": {
          "name": "${{values.maas_model}}"
        }
      }
    }
  }
}
